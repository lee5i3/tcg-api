{
  "name": "local-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "tools/local-gateway", "command": "go build ./..." }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "tools/local-gateway", "command": "go test ./..." }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/local-gateway",
        "commands": ["go vet ./...", "test -z \"$(gofmt -l .)\" || (gofmt -l . && exit 1)"]
      }
    }
  }
}
