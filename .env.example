# PostgreSQL connection string (see docker-compose.yml)
DATABASE_URL="postgres://pg-user:pg-pass@localhost:5432/tcg-api?sslmode=disable"

# Port the API listens on (default 8080)
PORT=8080

# Optional: when set, every gRPC call (except reflection) requires
# "authorization: Bearer <token>" metadata. GraphQL stays public read-only.
API_TOKEN=

# Port the gRPC server (service-to-service) listens on (default 50051)
GRPC_PORT=50051
