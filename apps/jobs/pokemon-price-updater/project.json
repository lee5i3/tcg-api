{
  "name": "pokemon-price-updater",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["card-catalog-store", "httpapi"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/jobs/pokemon-price-updater", "command": "go build ./..." }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/jobs/pokemon-price-updater", "command": "go test ./..." }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/jobs/pokemon-price-updater",
        "commands": ["go vet ./...", "test -z \"$(gofmt -l .)\" || (gofmt -l . && exit 1)"]
      }
    }
  }
}
