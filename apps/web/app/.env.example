# Base URL for the TCG catalog REST API.
#
# Leave unset (or empty) for same-origin requests: the site is served behind
# nginx/CloudFront together with the API, so the client uses relative
# /v1/... URLs by default.
#
# Set it only when pointing the dev server at a remote API, e.g.:
# VITE_API_URL=http://localhost:8080
VITE_API_URL=
