{
  "name": "api-set-routes",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "card-catalog-store",
    "httpapi"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api/set-routes",
        "command": "go build ./..."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api/set-routes",
        "command": "go test ./..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api/set-routes",
        "commands": [
          "go vet ./...",
          "test -z \"$(gofmt -l .)\" || (gofmt -l . && exit 1)"
        ]
      }
    }
  }
}
